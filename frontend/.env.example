# URL de l'API backend
NEXT_PUBLIC_API_URL=

# Adresses des smart contracts deployes (Polygon)
NEXT_PUBLIC_CONTRACT_MANAGER_ADDRESS=
NEXT_PUBLIC_CONTRACT_NFT_ADDRESS=

# Privy (authentification)
NEXT_PUBLIC_PRIVY_APP_ID=

# Passerelle IPFS publique utilisee pour les liens "Voir sur IPFS" (defaut si vide :
# gateway.pinata.cloud, qui refuse de servir du contenu text/html — cas des contrats generes
# par IA). Mettre la passerelle dediee de votre compte Pinata (tableau de bord Pinata >
# Gateways) pour lever cette restriction. Doit correspondre a PINATA_GATEWAY cote backend
# (backend/.env.example).
NEXT_PUBLIC_IPFS_GATEWAY=
